{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled vocabulary",
  "description": "One schema for every file under vocab/, discriminated by which collection key is present. A file declaring two collections is rejected: the collection decides which rules apply, so ambiguity there makes every later rule unenforceable.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "reviewed": {"$ref": "#/$defs/date"},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name", "scope"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "name": {"type": "string", "minLength": 3},
          "scope": {"type": "string", "minLength": 10}
        }
      }
    },
    "axes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description", "slugs"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z]+$"},
          "universal": {"type": "boolean"},
          "description": {"type": "string", "minLength": 20},
          "slugs": {
            "type": "object", "minProperties": 2,
            "propertyNames": {"pattern": "^[A-Z0-9]{2,10}$"},
            "additionalProperties": {"type": "string", "minLength": 5}
          }
        }
      }
    },
    "surfaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tag", "label", "description", "discovery_hint"],
        "properties": {
          "tag": {"$ref": "#/$defs/slug"},
          "label": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 20},
          "discovery_hint": {"type": "string", "minLength": 10},
          "emits": {"type": "array", "items": {"$ref": "#/$defs/slug"}}
        }
      }
    },
    "dimensions": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z_]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "values"],
        "properties": {
          "label": {"type": "string", "minLength": 3},
          "values": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": {"$ref": "#/$defs/slug"},
                "label": {"type": "string", "minLength": 2},
                "note": {"type": "string", "minLength": 10}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
