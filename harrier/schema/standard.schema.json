{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned published standard",
  "description": "A generated index of a published standard's identifiers and official titles. The pin fields are required so a future regeneration cannot quietly drop the evidence: a commit plus the SHA-256 of the file read at it lets anyone re-fetch the exact bytes, which a branch name cannot do because a branch moves.",
  "type": "object",
  "required": ["version", "source", "source_commit", "source_sha256", "retrieved", "wstg"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "source": {"type": "string", "minLength": 5},
    "source_ref": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "wstg": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "verified"],
        "properties": {
          "id": {"type": "string", "pattern": "^WSTG-[A-Z]{4}-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 3},
          "verified": {"type": "boolean"}
        }
      }
    }
  }
}
