{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic",
  "description": "A coherent subject, roughly what a published standard calls one test. Its units are what a person actually performs. A topic declares exactly one primary axis; needing two means either the topic should split or the second axis is a dimension.",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/topic_id"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "domain": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "axis": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "description": "The vocabulary this topic's units may draw from beyond the universal axes. Omitted when the topic decomposes only into universal slugs -- declaring an axis no unit uses states a constraint that constrains nothing."
    },
    "kind": {
      "enum": [
        "test",
        "recon",
        "inquiry"
      ]
    },
    "status": {
      "enum": [
        "outline",
        "sketched",
        "authored"
      ]
    },
    "surfaces": {
      "$ref": "#/$defs/surface_clause"
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/slug"
        },
        "uniqueItems": true
      }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit_id"
      },
      "uniqueItems": true
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "home",
          "note"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 3
          },
          "home": {
            "oneOf": [
              {
                "$ref": "#/$defs/topic_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "see_also": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic_id"
      },
      "uniqueItems": true
    },
    "refs": {
      "$ref": "#/$defs/refs"
    }
  },
  "$defs": {
    "topic_id": {
      "type": "string",
      "pattern": "^HRR-[A-Z]{3}-[0-9]{2}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^HRR-[A-Z]{3}-[0-9]{2}-[A-Z0-9]{2,10}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "surface_clause": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "none_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "always": {
          "const": true
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wstg": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WSTG-[A-Z]{4}-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "cwe": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "asvs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "capec": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
,
  "allOf": [
    {
      "$comment": "Every topic says where it applies, except an outcome topic, which does not apply to a surface at all. An outcome is reached from wherever a capability was established, so a surface list there would either name everything or name a tag invented to mean nothing. Required everywhere else, because a topic that cannot say where it applies is one nobody can decide to skip.",
      "if": {
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "not": {
              "const": "OUT"
            }
          }
        }
      },
      "then": {
        "required": [
          "surfaces"
        ]
      }
    },
    {
      "$comment": "The reverse, so the exemption cannot be borrowed. An outcome topic that declared a surface would be claiming something the model has no way to honour.",
      "if": {
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "const": "OUT"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "surfaces"
          ]
        }
      }
    }
  ]
}
